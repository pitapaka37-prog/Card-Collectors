rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // shared gachas: anyone can read, only the maker (anonymous sign-in id) can change them
    match /packs/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.owner == request.auth.uid;

      match /cards/{cardId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && get(/databases/$(database)/documents/packs/$(code)).data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.data.size() < 600000;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/packs/$(code)).data.owner == request.auth.uid;
      }
    }
  }
}
