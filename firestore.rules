rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // shared gachas: anyone can read; the maker (anonymous sign-in id) changes them,
    // and members who joined with the co-creation code can add / edit / delete cards
    match /packs/{code} {
      function pack() { return get(/databases/$(database)/documents/packs/$(code)).data; }
      function isMember() { return exists(/databases/$(database)/documents/packs/$(code)/members/$(request.auth.uid)); }

      allow read: if true;
      allow create: if request.auth != null
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid)
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ver', 'count']))
      );
      allow delete: if request.auth != null
        && resource.data.owner == request.auth.uid;

      match /cards/{cardId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && (pack().owner == request.auth.uid || isMember())
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.data.size() < 600000;
        allow delete: if request.auth != null
          && (pack().owner == request.auth.uid || isMember());
      }

      match /members/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/collab/$(request.resource.data.key)).data.pack == code;
        allow delete: if request.auth != null
          && (request.auth.uid == uid || pack().owner == request.auth.uid);
      }
    }

    // co-creation codes: you can only look one up if you know it (no listing)
    match /collab/{key} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && key.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid
        && get(/databases/$(database)/documents/packs/$(request.resource.data.pack)).data.owner == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.owner == request.auth.uid;
    }
  }
}
